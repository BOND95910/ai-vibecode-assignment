{
  "name": "egov-eservice-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E suite for the e-Service (51 TC from TEST-PLAN.md). Run against BASE_URL with TEST_MODE=1.",
  "scripts": {
    "test": "playwright test",
    "test:part1": "playwright test e2e/part1.spec.ts",
    "test:part2": "playwright test e2e/part2.spec.ts",
    "list": "playwright test --list",
    "install-browsers": "playwright install chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
